# HydraDB is optional for parser/unit tests, but required for the infrastructure gate.
HYDRADB_BOLT_URI=bolt://localhost:7687
HYDRADB_USERNAME=neo4j
HYDRADB_DATABASE=default
HYDRADB_CONSISTENCY=causal
HYDRADB_HTTP_URL=http://localhost:8443
HYDRADB_ADMIN_URL=http://localhost:9090
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0
HYDRADB_NAMESPACE=development
HYDRADB_AUTH_TOKEN=
HYDRADB_AUTH_TOKEN_FILE=infra/local/secrets/auth-token

# Required only when the graph node persists directly to S3-compatible storage.
HYDRADB_S3_ENDPOINT=
HYDRADB_S3_REGION=us-east-1
HYDRADB_S3_BUCKET=hydratrace-graph
HYDRADB_S3_PREFIX=development/
HYDRADB_S3_ACCESS_KEY_ID=
HYDRADB_S3_SECRET_ACCESS_KEY=

OSV_BASE_URL=https://api.osv.dev
ENGINE_HOST=127.0.0.1
ENGINE_PORT=4100
ENGINE_RATE_LIMIT_PER_MINUTE=120
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_HYDRATRACE_API_URL=http://127.0.0.1:4100

# Durable orchestration (optional locally, required for serverless production).
CONVEX_URL=

# Preferred grounded-AI path: the private Cloudflare Worker gateway.
AI_GATEWAY_URL=
AI_GATEWAY_SHARED_SECRET=

# Optional direct providers for local development/fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
