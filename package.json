{
  "name": "hydratrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run test",
    "scan:fixture": "tsx apps/engine/src/commands/scan-fixture.ts",
    "smoke:osv": "tsx apps/engine/src/commands/osv-smoke.ts",
    "smoke:hydradb": "node --env-file-if-exists=.env --import tsx apps/engine/src/commands/hydradb-smoke.ts",
    "start:engine": "node --env-file-if-exists=.env --import tsx apps/engine/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
